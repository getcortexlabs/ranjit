# Generate a key with: openssl rand -hex 32
# Or run make setup to create .env with a random key.
RANJIT_API_KEY=
RANJIT_ADDR=127.0.0.1:8080
RANJIT_BASE_URL=http://localhost:8080
RANJIT_DATABASE=./data/ranjit.db
RANJIT_PROVIDER=sandbox
RANJIT_SYNC_INTERVAL=1h

# Optional Efí connector. See docs/efi.md before selecting RANJIT_PROVIDER=efi.
RANJIT_EFI_ENV=homologation
RANJIT_EFI_CLIENT_ID=
RANJIT_EFI_CLIENT_SECRET_FILE=./secrets/efi-client-secret
RANJIT_EFI_CERT_FILE=./secrets/efi-cert.pem
RANJIT_EFI_KEY_FILE=./secrets/efi-key.pem
RANJIT_EFI_LOOKBACK_DAYS=90

# Optional Inter Empresas connector (PJ only). See docs/inter.md.
RANJIT_INTER_ENV=sandbox
RANJIT_INTER_CLIENT_ID=
RANJIT_INTER_CLIENT_SECRET_FILE=./secrets/inter-client-secret
RANJIT_INTER_CERT_FILE=./secrets/inter-cert.pem
RANJIT_INTER_KEY_FILE=./secrets/inter-key.pem
RANJIT_INTER_ACCOUNT=
RANJIT_INTER_LOOKBACK_DAYS=7

# Optional Sicoob connector. Sandbox uses the access token from the portal.
# For production unset ACCESS_TOKEN_FILE and supply CERT_FILE/KEY_FILE.
# See docs/sicoob.md.
RANJIT_SICOOB_ENV=sandbox
RANJIT_SICOOB_CLIENT_ID=
RANJIT_SICOOB_ACCESS_TOKEN_FILE=./secrets/sicoob-sandbox-token
RANJIT_SICOOB_CERT_FILE=./secrets/sicoob-cert.pem
RANJIT_SICOOB_KEY_FILE=./secrets/sicoob-key.pem
RANJIT_SICOOB_ACCOUNT=
RANJIT_SICOOB_LOOKBACK_DAYS=7

# Optional C6 Empresas connector. Saldo and statement. See docs/c6.md.
RANJIT_C6_ENV=sandbox
RANJIT_C6_CLIENT_ID=
RANJIT_C6_CLIENT_SECRET_FILE=./secrets/c6-client-secret
RANJIT_C6_CERT_FILE=./secrets/c6-cert.pem
RANJIT_C6_KEY_FILE=./secrets/c6-key.pem
RANJIT_C6_LOOKBACK_DAYS=7

# Optional Santander Empresas connector. See docs/santander.md.
RANJIT_SANTANDER_ENV=sandbox
RANJIT_SANTANDER_CLIENT_ID=
RANJIT_SANTANDER_CLIENT_SECRET_FILE=./secrets/santander-client-secret
RANJIT_SANTANDER_CERT_FILE=./secrets/santander-cert.pem
RANJIT_SANTANDER_KEY_FILE=./secrets/santander-key.pem
# Exactly 4 branch digits, a dot, then 12 account digits (including check digit).
RANJIT_SANTANDER_ACCOUNT=
RANJIT_SANTANDER_LOOKBACK_DAYS=7

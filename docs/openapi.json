{
  "openapi": "3.1.0",
  "info": {
    "title": "Ranjit API",
    "version": "0.3.0",
    "description": "Self-hosted financial data API with a local sandbox and direct Efí / Inter Empresas adapters. Bank account access requires credentials issued to the operator; coverage depends on the provider.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local sandbox"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Check process liveness",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "summary": "Check database readiness",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/institutions": {
      "get": {
        "operationId": "listInstitutions",
        "summary": "List configured institutions and data coverage",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstitutionPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/v1/connections": {
      "post": {
        "operationId": "createConnection",
        "summary": "Create a connection using the configured authorization mode",
        "responses": {
          "201": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "description": "Relative resource location.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "502": {
            "$ref": "#/components/responses/Error502"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectRequest"
              }
            }
          }
        },
        "description": "This operation is not idempotent. Repeating it creates another connection."
      },
      "get": {
        "operationId": "listConnections",
        "summary": "List connections for one customer",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CustomerID"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      }
    },
    "/v1/connections/{id}": {
      "get": {
        "operationId": "getConnection",
        "summary": "Get connection status",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ]
      },
      "delete": {
        "operationId": "revokeConnection",
        "summary": "Revoke and delete normalized financial data",
        "responses": {
          "204": {
            "description": "Revoked; no response body",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ]
      }
    },
    "/v1/connections/{id}/sync": {
      "post": {
        "operationId": "syncConnection",
        "summary": "Enqueue a sync or return its existing active job",
        "responses": {
          "202": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "description": "Relative resource location.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ]
      }
    },
    "/v1/connections/{id}/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "List accounts and balances",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      }
    },
    "/v1/accounts/{id}/transactions": {
      "get": {
        "operationId": "listTransactions",
        "summary": "List transactions ordered by ID",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Get synchronization job status",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ]
      }
    },
    "/sandbox/authorize": {
      "get": {
        "operationId": "showSandboxConsent",
        "summary": "Show the simulated consent form without authorizing",
        "responses": {
          "200": {
            "description": "Sandbox authorization form",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "410": {
            "$ref": "#/components/responses/Error410"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 20,
              "maxLength": 128
            }
          }
        ]
      },
      "post": {
        "operationId": "decideSandboxConsent",
        "summary": "Approve or deny a sandbox consent once",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Generated request identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "410": {
            "$ref": "#/components/responses/Error410"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/SandboxDecision"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "ID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "maxLength": 128
        },
        "description": "next_cursor from the preceding page, using the same filters."
      },
      "CustomerID": {
        "name": "customer_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "schemas": {
      "Institution": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "sandbox",
              "efi",
              "inter"
            ]
          },
          "sandbox": {
            "type": "boolean",
            "description": "True for the local sandbox, Efí homologation or Inter sandbox; false for bank production environments."
          },
          "connection_mode": {
            "type": "string",
            "enum": [
              "sandbox_consent",
              "api_credentials"
            ]
          },
          "data_coverage": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Coverage of the configured adapter. Inter exposes available balance and account statement; Efí exposes balance, received Pix and completed refunds."
          }
        },
        "required": [
          "id",
          "name",
          "provider",
          "sandbox",
          "connection_mode",
          "data_coverage"
        ]
      },
      "Connection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "institution_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "sandbox",
              "efi",
              "inter"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "denied",
              "expired",
              "revoked"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "consent_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Local collection deadline. For api_credentials this is not a consent registered at the bank."
          },
          "last_synced_at": {
            "type": "string",
            "format": "date-time"
          },
          "authorization_mode": {
            "type": "string",
            "enum": [
              "sandbox_consent",
              "api_credentials"
            ]
          }
        },
        "required": [
          "id",
          "customer_id",
          "institution_id",
          "provider",
          "status",
          "created_at",
          "consent_expires_at",
          "authorization_mode"
        ]
      },
      "ConnectRequest": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Opaque application customer ID. The server enforces a 128-byte UTF-8 limit."
          },
          "institution_id": {
            "type": "string",
            "enum": [
              "sandbox-bank",
              "sandbox-credit-union",
              "efi",
              "inter"
            ]
          }
        },
        "required": [
          "customer_id",
          "institution_id"
        ],
        "additionalProperties": false
      },
      "ConnectResponse": {
        "type": "object",
        "properties": {
          "connection": {
            "$ref": "#/components/schemas/Connection"
          },
          "authorization_url": {
            "type": "string",
            "format": "uri",
            "description": "Present only for the local sandbox consent flow."
          },
          "authorization_expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "connection"
        ]
      },
      "Money": {
        "type": "object",
        "properties": {
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Signed centavos. Negative amounts are debits."
          },
          "currency": {
            "type": "string",
            "enum": [
              "BRL"
            ]
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "connection_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "checking",
              "savings",
              "payment"
            ]
          },
          "balance": {
            "$ref": "#/components/schemas/Money"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "connection_id",
          "name",
          "type",
          "balance",
          "updated_at"
        ]
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "posted_on": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "booked",
              "pending"
            ]
          }
        },
        "required": [
          "id",
          "account_id",
          "description",
          "amount",
          "posted_on",
          "status"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "connection_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "error_code": {
            "type": "string",
            "enum": [
              "provider_unavailable",
              "invalid_provider_data",
              "storage_unavailable",
              "lease_exhausted",
              "provider_credentials"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "connection_id",
          "status",
          "attempts",
          "created_at",
          "updated_at"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ready",
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SandboxDecision": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 128
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "deny"
            ]
          }
        },
        "required": [
          "token",
          "decision"
        ]
      },
      "InstitutionPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Institution"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "data"
        ]
      },
      "ConnectionPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Connection"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "data"
        ]
      },
      "AccountPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "data"
        ]
      },
      "TransactionPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "data"
        ]
      }
    },
    "responses": {
      "Error401": {
        "description": "Invalid or missing bearer token",
        "headers": {
          "X-Request-ID": {
            "description": "Generated request identifier.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error500": {
        "description": "Internal error",
        "headers": {
          "X-Request-ID": {
